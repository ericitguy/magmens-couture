# ---------------------------------------------------------------------------
# Magmens Couture — environment variables
#
# Copy this file to .env.local for development, and set the same names in the
# hosting provider's dashboard for production. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, the sitemap, robots.txt and social
# previews. Set this to the live domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.magmenscouture.com

# ---------------------------------------------------------------------------
# Enquiry storage — REQUIRED before launch
# ---------------------------------------------------------------------------
# Neon serverless PostgreSQL connection string. Consultation and contact form
# submissions are written to an `enquiries` table that is created on first use.
#   Neon: https://console.neon.tech → your project → Connection details
# Without this the forms still work, but submissions are appended to
# ./data/enquiries.jsonl on the local disk — which is not available on a
# serverless host, so a database is required for production.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Studio email alerts — optional but recommended
# ---------------------------------------------------------------------------
# When both of these are set, every enquiry is emailed to the studio through
# Resend. Until they are set, enquiries are stored and visible in the admin
# view, and no email is sent.
#   Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Where notifications are delivered (the studio's monitored inbox).
ENQUIRY_NOTIFICATION_EMAIL=

# The verified sender, once the studio's domain is verified with Resend.
# Until then the Resend test sender is used.
# Example: "Magmens Couture Website <enquiries@magmenscouture.com>"
ENQUIRY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Studio admin view — optional
# ---------------------------------------------------------------------------
# Long, random secret. Unlocks /admin/enquiries?token=... to read the stored
# requests. Without it, the admin route returns 404.
# Generate one with:  openssl rand -hex 32
ADMIN_ACCESS_TOKEN=
